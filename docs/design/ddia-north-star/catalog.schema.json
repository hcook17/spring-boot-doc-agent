{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ddia-north-star-catalog.schema.json",
  "title": "DDIANorthStarCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "last_refined", "entries"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "last_refined": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "$comment": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "completeness", "path", "tags", "related", "last_refined"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "kind": {
            "type": "string",
            "enum": [
              "concept",
              "playbook",
              "chapter",
              "taxonomy",
              "domain",
              "relationship",
              "deviation"
            ]
          },
          "completeness": { "type": "string", "enum": ["outline", "partial", "operational"] },
          "path": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "related": { "type": "array", "items": { "type": "string" } },
          "epub_anchors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["chapter", "title"],
              "properties": {
                "chapter": { "type": "integer", "minimum": 1, "maximum": 14 },
                "fragment": { "type": "string" },
                "title": { "type": "string" }
              }
            }
          },
          "last_refined": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    }
  }
}
